# Grok (xAI) API key for the VoiceCoach demo. Server-side only — never exposed
# to the browser. Add the real value in Vercel → Settings → Environment Variables
# (and in a local, gitignored .env.local for dev). Leave unset to use the
# built-in fallback coach.
XAI_API_KEY=

# Optional: override the Grok model (defaults to grok-2-latest)
# XAI_MODEL=grok-3

# "Now playing" sticky, via Last.fm (works with a FREE Spotify account, unlike
# the Spotify Web API). Leave unset and the widget never appears. To wire it up:
#   1. Make a Last.fm account, then connect Spotify for scrobbling:
#      https://www.last.fm/settings/applications
#   2. Create an API account to get a key: https://www.last.fm/api/account/create
#   3. Set both below (and the same in Vercel → Environment Variables for prod).
LASTFM_API_KEY=
LASTFM_USERNAME=
