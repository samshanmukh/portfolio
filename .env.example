# Grok (xAI) API key for the VoiceCoach demo. Server-side only — never exposed
# to the browser. Add the real value in Vercel → Settings → Environment Variables
# (and in a local, gitignored .env.local for dev). Leave unset to use the
# built-in fallback coach.
XAI_API_KEY=

# Optional: override the Grok model (defaults to grok-2-latest)
# XAI_MODEL=grok-3

# Spotify "now playing" widget (bottom-right corner). All three are needed; leave them
# unset and the widget simply stays hidden. Get the refresh token once with
# `node scripts/get-spotify-token.mjs`.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# GitHub token for the live project stats (commits, releases, languages) and "building
# lately" card. Optional but recommended: without it GitHub allows only 60 requests/hour
# from Vercel's shared IPs and the cards fall back to the static list. A fine-grained
# token with "Public repositories (read-only)" access is enough.
GITHUB_TOKEN=
